# ============================================
# EJEMPLO DE CONFIGURACIÓN (.env.example)
# Copia este archivo a .env y completa con tus valores reales.
# NUNCA subas .env a GitHub ni compartas las credenciales reales.
# ============================================

# --- Puerto del servidor ---
PORT=3000

# --- Base de datos MySQL (Aiven / Render / local) ---
DB_HOST=TU_HOST_DE_BD
DB_PORT=3306
DB_USER=TU_USUARIO_BD
DB_PASSWORD=TU_PASSWORD_BD
DB_NAME=TU_NOMBRE_BD
# true si la conexión requiere SSL (Aiven/Render), false en local
DB_SSL=false

# --- JWT ---
# Usa una clave larga y aleatoria, ejemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CAMBIAME_POR_UNA_CLAVE_LARGA_ALEATORIA
JWT_EXPIRES_IN=8h

# --- Usuario administrador inicial (se crea solo si no existe en la BD) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CAMBIAME_LA_CONTRASENA